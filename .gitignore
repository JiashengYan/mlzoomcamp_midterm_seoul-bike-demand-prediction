# Local Python environments and caches
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Local settings and secrets
.env
.env.*
!.env.example

# Keep the fixed CSV and final model; ignore other generated files.
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/SeoulBikeData.csv
/models/*
!/models/.gitkeep
!/models/model.joblib

# Chinese development documents and notebooks remain local.
*_CHI.md
*_CHI.ipynb

# Local collaboration rules, work history, and owner decisions.
/AGENTS.md
/docs/WORKLOG.md
/docs/TODO.md
